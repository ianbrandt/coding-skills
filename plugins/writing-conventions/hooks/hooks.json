{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/rules.md\"",
            "timeout": 5,
            "statusMessage": "Loading writing rules..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\"",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "Checking the text for AI tells..."
          },
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/gate.ps1"],
            "timeout": 60,
            "statusMessage": "Checking the text for AI tells..."
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\"",
            "shell": "bash",
            "timeout": 90,
            "statusMessage": "Checking the text for AI tells..."
          },
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/gate.ps1"],
            "timeout": 90,
            "statusMessage": "Checking the text for AI tells..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/lint.sh\" --record",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Linting the reply..."
          },
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/lint.ps1", "--record"],
            "timeout": 10,
            "statusMessage": "Linting the reply..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/rules-context.sh\" SubagentStart",
            "shell": "bash",
            "timeout": 5,
            "statusMessage": "Loading writing rules..."
          },
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/rules-context.ps1", "SubagentStart"],
            "timeout": 5,
            "statusMessage": "Loading writing rules..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/lint.sh\" --emit",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking the last reply's lint..."
          },
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/lint.ps1", "--emit"],
            "timeout": 10,
            "statusMessage": "Checking the last reply's lint..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/lint.sh\" --nudge",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking for a prose write..."
          },
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/lint.ps1", "--nudge"],
            "timeout": 10,
            "statusMessage": "Checking for a prose write..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\" --file",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "Checking the file for AI tells..."
          },
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/gate.ps1", "--file"],
            "timeout": 60,
            "statusMessage": "Checking the file for AI tells..."
          }
        ]
      }
    ]
  }
}
