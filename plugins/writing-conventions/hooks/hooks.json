{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/rules.md\"",
            "timeout": 5,
            "statusMessage": "Loading writing rules..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "echo @'\n' >/dev/null; exec bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\"\n'@ >$null; pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.ps1\"; exit $LASTEXITCODE #'",
            "timeout": 180,
            "statusMessage": "Checking the text for AI tells..."
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "echo @'\n' >/dev/null; exec bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\"\n'@ >$null; pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.ps1\"; exit $LASTEXITCODE #'",
            "timeout": 90,
            "statusMessage": "Checking the text for AI tells..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo @'\n' >/dev/null; exec bash \"${CLAUDE_PLUGIN_ROOT}/hooks/lint.sh\" --record\n'@ >$null; pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/lint.ps1\" --record; exit $LASTEXITCODE #'",
            "timeout": 10,
            "statusMessage": "Linting the reply..."
          },
          {
            "type": "command",
            "command": "echo @'\n' >/dev/null; exec bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\" --stop\n'@ >$null; pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.ps1\" --stop; exit $LASTEXITCODE #'",
            "timeout": 60,
            "statusMessage": "Checking the draft for AI tells..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo @'\n' >/dev/null; exec bash \"${CLAUDE_PLUGIN_ROOT}/hooks/rules-context.sh\" SubagentStart\n'@ >$null; pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/rules-context.ps1\" SubagentStart; exit $LASTEXITCODE #'",
            "timeout": 5,
            "statusMessage": "Loading writing rules..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo @'\n' >/dev/null; exec bash \"${CLAUDE_PLUGIN_ROOT}/hooks/lint.sh\" --emit\n'@ >$null; pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/lint.ps1\" --emit; exit $LASTEXITCODE #'",
            "timeout": 10,
            "statusMessage": "Checking the last reply's lint..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo @'\n' >/dev/null; exec bash \"${CLAUDE_PLUGIN_ROOT}/hooks/lint.sh\" --nudge\n'@ >$null; pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/lint.ps1\" --nudge; exit $LASTEXITCODE #'",
            "timeout": 10,
            "statusMessage": "Checking for a prose write..."
          },
          {
            "type": "command",
            "command": "echo @'\n' >/dev/null; exec bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\" --file\n'@ >$null; pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.ps1\" --file; exit $LASTEXITCODE #'",
            "timeout": 60,
            "statusMessage": "Checking the file for AI tells..."
          }
        ]
      }
    ]
  }
}
