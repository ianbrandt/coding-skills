{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/rules.md\"",
            "timeout": 5,
            "statusMessage": "Loading communication rules..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "esc=$(sed -e 's/\\\\/\\\\\\\\/g' -e 's/\"/\\\\\"/g' \"${CLAUDE_PLUGIN_ROOT}/hooks/rules.md\" | awk '1' ORS='\\\\n'); printf '{\"hookSpecificOutput\":{\"hookEventName\":\"SubagentStart\",\"additionalContext\":\"%s\"}}' \"$esc\"",
            "timeout": 5,
            "statusMessage": "Loading communication rules..."
          }
        ]
      }
    ]
  }
}
